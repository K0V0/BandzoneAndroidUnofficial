# Copy to keystore.properties (gitignored) to sign release builds.
# Create a keystore first:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias bandzone
# storeFile is resolved relative to the project root.
storeFile=release.jks
storePassword=
keyAlias=bandzone
keyPassword=
